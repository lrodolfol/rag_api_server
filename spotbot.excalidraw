    {
      "id": "sWCZuix0TloWL-Y3j7YkT",
      "type": "text",
      "x": 532,
      "y": 982,
      "width": 1082.3670654296875,
      "height": 480,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
